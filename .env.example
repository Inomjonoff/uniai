# ==========================================
# UNICON-SOFT AI Technical Assistant - Config
# ==========================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Admin Telegram User IDs (Comma-separated integer IDs allowed to use private assistant)
ADMIN_USER_IDS=123456789,987654321

# Database Configuration (PostgreSQL + pgvector)
# On Render: Use the Internal Database URL from Render Managed Postgres
DATABASE_URL=postgresql+asyncpg://uniai_user:uniai_password@localhost:5432/uniai_db

# Redis URL for background job queue & caching
# On Render: Use the Internal Redis URL from Render Managed Redis (or leave empty for in-memory async fallback)
REDIS_URL=redis://localhost:6379/0

# Gemini Models
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Webhook & Deployment
# On Render: Set your app domain e.g. https://unicon-ai-assistant.onrender.com
# If WEBHOOK_URL is empty, bot will run in Long Polling mode (ideal for local testing)
WEBHOOK_URL=
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=your_super_secret_webhook_key

# Application Port
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# Group Processing Options
GROUP_BATCH_WINDOW_SECONDS=60
GROUP_LEARNING_DEFAULT=true
GROUP_REPLY_DEFAULT=false
